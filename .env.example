# Register this exact callback URL with the Authentik OIDC provider.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://your-portal.example/api/auth/oidc/callback
# Optional: explicitly grant this Authentik subject initial superadmin access.
OIDC_SUPERADMIN_SUB=
# Generate a unique, high-entropy value; never commit your real secret.
JWT_SECRET=
