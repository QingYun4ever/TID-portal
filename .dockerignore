# 依赖与产物（镜像内重新安装 / 构建）
node_modules
dist

# 构建只携带公开内容快照，不携带本地账号、报名、留言与上传数据
data/*
!data/display-content.json
*.db
uploads
*.db-wal
*.db-shm
*.db-journal

# 机密：OIDC client secret、JWT_SECRET 等只通过环境变量注入
.env
.env.*
!.env.example

# 版本控制与本地工具
.git
.gitignore
scripts
*.log

# 本机生成的编译残留
vite.config.js
tsconfig.tsbuildinfo

# 文档与启动脚本（构建不需要）
AGENT-BRIEF.md
design.md
dev.bat
dev.sh
build.bat
build.sh
